{
  "name": "simple-proxy",
  "version": "2.2.4",
  "private": true,
  "scripts": {
    "prepare": "nitropack prepare",
    "dev": "nitropack dev",
    "build": "nitropack build",
    "build:cloudflare": "NITRO_PRESET=cloudflare pnpm run build",
    "build:aws": "NITRO_PRESET=aws_lambda pnpm run build",
    "build:node": "NITRO_PRESET=node-server pnpm run build",
    "build:netlify": "NITRO_PRESET=netlify_edge pnpm run build",
    "start": "node .output/server/index.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "h3": "^1.15.11",
    "jose": "^5.10.0",
    "nitropack": "^2.13.3"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.60.1",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.58.0"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node"
    }
  }
}
